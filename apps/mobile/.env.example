# Expo reads this file from apps/mobile when the dev command runs there.
# Keep the default disconnected until an explicit runtime is configured.
EXPO_PUBLIC_API_MODE=disabled
EXPO_PUBLIC_ENVIRONMENT=dev
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
EXPO_PUBLIC_APP_VERSION=0.0.0
EXPO_PUBLIC_PERSONAL_PREVIEW=false

# Local fixture only. Leave empty in staging/production and never reuse these
# names for live credentials. Expo embeds public values in the bundle regardless
# of runtime mode, so never set these fixture values for a distributed build.
EXPO_PUBLIC_FIXTURE_APP_TOKEN=
EXPO_PUBLIC_FIXTURE_DEVICE_ID=
EXPO_PUBLIC_FIXTURE_OWNER_CREDENTIAL=
