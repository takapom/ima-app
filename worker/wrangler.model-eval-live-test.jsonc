{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ima-api-model-eval-live-test",
  "main": "tests/model-eval-live/model-eval-live-worker.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "MODEL_EVAL_THREADS", "class_name": "ModelEvalThreadDO" },
      {
        "name": "MODEL_EVAL_FIXTURE_LIVE_THREADS",
        "class_name": "ModelEvalFixtureLiveThreadDO",
      },
      { "name": "MODEL_EVAL_CONTEXT_THREADS", "class_name": "ModelEvalFixtureThreadDO" },
      { "name": "SAVED_REFERENCES", "class_name": "SavedReferenceDO" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ModelEvalThreadDO", "ModelEvalFixtureThreadDO", "SavedReferenceDO"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ModelEvalFixtureLiveThreadDO"],
    },
  ],
}
