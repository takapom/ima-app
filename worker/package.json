{
  "name": "@ima/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./entrypoints/cloudflare/worker.ts",
      "default": "./entrypoints/cloudflare/worker.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "dev:llm": "wrangler dev --config wrangler.runtime-dev-fixture-test.jsonc --env-file .dev.vars.llm --local --port 8787 --var IMA_RUNTIME_MODE:live --var IMA_PROVIDER_OPENAI:true --var IMA_PROVIDER_PLACES:false --var IMA_PROVIDER_ROUTES:false --var IMA_PROVIDER_LAST_TRAIN:false --var IMA_PROVIDER_HOTPEPPER:true",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p tooling/tsconfig.json --noEmit",
    "build": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.69",
    "@cloudflare/think": "0.17.0",
    "@ima/contracts": "workspace:*",
    "@ima/core": "workspace:*",
    "agents": "0.22.0",
    "ai": "6.0.182",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@cloudflare/ai-chat": "0.11.0",
    "zod": "4.5.4"
  }
}
