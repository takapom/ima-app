{
  "name": "@ima/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/entrypoints/cloudflare/worker.ts",
      "default": "./src/entrypoints/cloudflare/worker.ts"
    }
  },
  "scripts": {
    "dev": "cf dev --persist-to .wrangler/state",
    "dev:llm": "wrangler dev --config wrangler.dev.jsonc --env-file .dev.vars.llm --local --port 8787",
    "typecheck": "tsc -p tsconfig.business.json --noEmit && tsc --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p tooling/tsconfig.json --noEmit",
    "build": "cf deploy --dry-run"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.69",
    "@cloudflare/think": "0.17.0",
    "@ima/contracts": "workspace:*",
    "agents": "0.22.0",
    "ai": "6.0.182",
    "hono": "4.13.8",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@cloudflare/ai-chat": "0.11.0",
    "cf": "1.0.0-beta.5",
    "wrangler": "4.143.0",
    "zod": "4.5.4"
  }
}
