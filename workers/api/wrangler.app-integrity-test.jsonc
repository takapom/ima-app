{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ima-api-app-integrity-test",
  "main": "tests/http/integration/app-integrity-self-worker.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "THREADS", "class_name": "ThreadDO" },
      { "name": "RATE_LIMITS", "class_name": "RateLimitDO" },
      { "name": "APP_INTEGRITY", "class_name": "AppIntegrityDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ThreadDO", "RateLimitDO"] },
    { "tag": "v2", "new_sqlite_classes": ["AppIntegrityDO"] },
  ],
  "vars": {
    "IMA_ENV": "dev",
    "IMA_RUNTIME_MODE": "fixture",
    "APP_ATTEST_MODE": "required",
    "APP_ATTEST_ENVIRONMENT": "development",
    "IMA_PROVIDER_OPENAI": "false",
    "IMA_PROVIDER_PLACES": "false",
    "IMA_PROVIDER_ROUTES": "false",
    "IMA_PROVIDER_LAST_TRAIN": "false",
    "IMA_PROVIDER_HOTPEPPER": "false",
    "IMA_KILL_SWITCH": "false",
    "IMA_RUNTIME_FLAGS_CONNECTED": "0",
  },
}
