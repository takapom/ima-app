{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ima-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "IMA_ENV": "dev",
    "IMA_RUNTIME_MODE": "fixture",
    "IMA_RUNTIME_FLAGS_CONNECTED": "0",
  },
  "durable_objects": {
    "bindings": [
      { "name": "THREADS", "class_name": "ThreadDO" },
      { "name": "RATE_LIMITS", "class_name": "RateLimitDO" },
      { "name": "JOURNEY_DATASETS", "class_name": "JourneyDatasetDO" },
      { "name": "TELEMETRY", "class_name": "TelemetryDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ThreadDO", "RateLimitDO"] },
    { "tag": "v2", "new_sqlite_classes": ["JourneyDatasetDO"] },
    { "tag": "v3", "new_sqlite_classes": ["TelemetryDO"] },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "env": {
    "staging": {
      "name": "ima-api-staging",
      "vars": {
        "IMA_ENV": "staging",
        "IMA_RUNTIME_MODE": "disabled",
        "IMA_RUNTIME_FLAGS_CONNECTED": "0",
      },
      "durable_objects": {
        "bindings": [
          { "name": "THREADS", "class_name": "ThreadDO" },
          { "name": "RATE_LIMITS", "class_name": "RateLimitDO" },
          { "name": "JOURNEY_DATASETS", "class_name": "JourneyDatasetDO" },
          { "name": "TELEMETRY", "class_name": "TelemetryDO" },
        ],
      },
    },
    "production": {
      "name": "ima-api-production",
      "vars": {
        "IMA_ENV": "production",
        "IMA_RUNTIME_MODE": "disabled",
        "IMA_RUNTIME_FLAGS_CONNECTED": "0",
      },
      "durable_objects": {
        "bindings": [
          { "name": "THREADS", "class_name": "ThreadDO" },
          { "name": "RATE_LIMITS", "class_name": "RateLimitDO" },
          { "name": "JOURNEY_DATASETS", "class_name": "JourneyDatasetDO" },
          { "name": "TELEMETRY", "class_name": "TelemetryDO" },
        ],
      },
    },
  },
}
