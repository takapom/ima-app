{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ima-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "THREADS", "class_name": "ThreadDO" },
      { "name": "RATE_LIMITS", "class_name": "RateLimitDO" },
      { "name": "JOURNEY_DATASETS", "class_name": "JourneyDatasetDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ThreadDO", "RateLimitDO"] },
    { "tag": "v2", "new_sqlite_classes": ["JourneyDatasetDO"] },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
