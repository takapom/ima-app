# Copy to .env.local for tooling that needs non-secret local configuration.
EXPO_PUBLIC_ENVIRONMENT=dev
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
# Set the real reverse-DNS bundle ID and EAS project only in a private build environment.
EXPO_IOS_BUNDLE_IDENTIFIER=
EAS_PROJECT_ID=
# App Attest is intentionally disabled until the #28 gate is implemented and verified.
APP_ATTEST_MODE=disabled
